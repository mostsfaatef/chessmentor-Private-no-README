<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 4: needed to post the daily puzzle reminder (Android 13+).
         Requested once on first launch in MainActivity; the app works
         without it, the reminder just can't appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChessMentorApplication"
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="ChessMentor"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChessMentor"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChessMentor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 4: daily puzzle reminder (AlarmManager, see DailyPuzzleScheduler). -->
        <receiver
            android:name=".notifications.DailyPuzzleReceiver"
            android:exported="false" />
    </application>
</manifest>
